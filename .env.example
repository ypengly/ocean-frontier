# Copy to .env and change secrets before any real deployment.
POSTGRES_USER=ocean
POSTGRES_PASSWORD=ocean_dev_password
POSTGRES_DB=ocean_frontier
DATABASE_URL=postgres://ocean:ocean_dev_password@postgres:5432/ocean_frontier?sslmode=disable
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-to-a-long-random-string
BACKEND_PORT=8080
SIMULATION_URL=http://simulation:8000
ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=info
VITE_API_URL=http://localhost:8080
